# --- Backend ---
DATABASE_URL=postgresql+psycopg://wiseos:wiseos@localhost:5432/wiseos
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- AI / verktyg (valfria – mock-fallback aktiveras automatiskt om tomma) ---
WOLFRAM_APP_ID=
# Alternativ: egen Wolfram Cloud-funktion (rekommenderas – billigare än Short Answers API)
# Exempel: https://www.wolframcloud.com/obj/simjan25/wiseOS/verifyMath
WOLFRAM_API_URL=
# Provider selection — "auto" resolves by available API keys.
# Deprecated: use GRADING_PROVIDER instead.
AI_PROVIDER=groq
OCR_PROVIDER=auto          # auto | mathpix | gemini | groq | openrouter
GRADING_PROVIDER=auto      # auto | gemini | groq | anthropic
FEEDBACK_PROVIDER=auto     # auto | groq | gemini | anthropic
#   PRODUCTION SWAP: när du har köpt riktig ANTHROPIC_API_KEY, sätt:
#     ANTHROPIC_API_KEY=<din_nyckel>
#     FEEDBACK_PROVIDER=anthropic
#   Utan nyckel failar feedback → needs_review (kraschar aldrig batchen).
MATH_PROVIDER=auto         # auto | wolfram | local
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Komma-separerade Supabase user IDs som får köra globala underhållsoperationer
# (t.ex. POST /api/v1/admin/retention/run). Tomt = ingen är admin → alla får 403.
ADMIN_USER_IDS=

# --- JWT Authentication ---
# VIKTIGT: Generera en säker nyckel i produktion med: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Ops ---
# dev | staging | prod — controls log format and Sentry environment tag.
ENVIRONMENT=dev
# Sentry DSN for error tracking. Empty = disabled (no overhead).
SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
